# Paper Stish authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Smart Edit — Cloudinary (free plan, no card required)
# Create a free Cloudinary account, enable an UNSIGNED upload preset that
# allows the paper-stish/user-assets folder, then fill these in. When unset,
# Smart Edit stores uploads in the browser (IndexedDB) instead.
NEXT_PUBLIC_SMART_EDIT_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_SMART_EDIT_CLOUDINARY_UPLOAD_PRESET=

# Smart Edit — optional remote library manifest (defaults to the bundled
# /smart-edit/library/manifest.json). Point this at a Cloudinary-hosted JSON
# using the same schema to serve the asset library from a CDN.
NEXT_PUBLIC_SMART_EDIT_LIBRARY_URL=
