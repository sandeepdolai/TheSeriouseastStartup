# ─── Database (Prisma + Neon PostgreSQL) ─────────────────────────────────────
# Paper Stish is a server application: the database stores PUBLISHED websites
# (publications), user accounts, and community templates. Unpublished
# editable projects live on each user's device (IndexedDB) and never touch
# the server.
#
# DATABASE_URL is the connection the application runtime uses. On Neon, use
# the POOLED connection string (host with the `-pooler` suffix) — serverless
# platforms like Vercel open many short-lived connections and must pool.
# DIRECT_URL is the direct (non-pooled) connection used by Prisma CLI
# migrations (prisma migrate deploy / migrate dev) so CREATE/ALTER DDL never
# goes through PgBouncer transaction mode. When the deployment has no pooler,
# set both to the same direct connection string.
#
# Keep these in Vercel's protected environment settings (or another secret
# manager) — never in the repository.
DATABASE_URL=
DIRECT_URL=

# ─── Authentication (NextAuth + Google) ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# ─── Dodo Payments — Pro subscription ──────────────────────────────────────
# Create a SUBSCRIPTION product priced at USD $4.99 every month.
# Checkout remains disabled until the API key, product ID, and webhook signing
# key are all configured. Start in test_mode with matching test-mode credentials
# and a test product; only switch to live_mode with matching live credentials.
# Keep these server-only: never use NEXT_PUBLIC_* or commit real values.
# Full instructions: docs/DODO_PAYMENTS_SETUP.md
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode

# ─── Smart Edit — Cloudinary (server-authorized signed uploads) ───────────
# Publish-time uploads are SERVER-AUTHORIZED: the browser calls
# POST /api/uploads/authorize first (session + per-user quotas checked
# server-side) and receives short-lived Cloudinary parameters signed with
# the server-only API secret, scoped to the user's own namespace
# (paper-stish/published-websites/u/<userId>/…). The browser holds no
# Cloudinary credentials.
#
# NEXT_PUBLIC_SMART_EDIT_CLOUDINARY_CLOUD_NAME must be set for the client
# upload path; the three CLOUDINARY_* server keys below must be set for the
# authorize endpoint and the publish-time media policy. When the public
# cloud name is unset, Smart Edit stores uploads in the browser (IndexedDB)
# instead and publishing falls back to bounded embedded photos (local
# development only).
NEXT_PUBLIC_SMART_EDIT_CLOUDINARY_CLOUD_NAME=

# ─── Smart Edit — optional remote library manifest ─────────────────────────
# Defaults to the bundled /smart-edit/library/manifest.json. Point this at a
# Cloudinary-hosted JSON using the same schema to serve the asset library
# from a CDN.
NEXT_PUBLIC_SMART_EDIT_LIBRARY_URL=

# ─── Cloudinary server-side credentials (NOT for browser code) ────────────
# Used by POST /api/uploads/authorize to sign upload parameters, by the
# publish/templates APIs to enforce the media policy, and by the cleanup
# scripts + GitHub Actions workflows. Never expose the API secret to the
# client and never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Signed-mode upload preset (unsigned=false) restricted to raster image
# formats. Create it once in the Cloudinary console (or via the Admin API):
#   name: paper_stish_signed_uploads, mode: signed,
#   allowed formats: jpg, jpeg, png, webp, gif, avif
# Only override this variable if you renamed the preset.
CLOUDINARY_SIGNED_UPLOAD_PRESET=
