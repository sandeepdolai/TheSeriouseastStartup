# ─── Database (Prisma) ──────────────────────────────────────────────────────
# Paper Stish is a server application: the database stores PUBLISHED websites
# (publications). Unpublished editable projects live on each user's device
# (IndexedDB) and never touch the server.
#
# Local development uses SQLite with a repo-relative path. For production,
# deploy to Vercel or any Node host and point DATABASE_URL at a DURABLE
# database — a local SQLite file is NOT durable on serverless platforms
# (their filesystems are ephemeral). Use a hosted database (e.g. Turso,
# Neon, or any managed Postgres/MySQL with an adjusted Prisma provider) or
# a Node host with a persistent volume for the SQLite file.
DATABASE_URL=file:./db/custom.db

# ─── Authentication (NextAuth + Google) ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# ─── Smart Edit — Cloudinary (free plan, no card required) ─────────────────
# Create a free Cloudinary account, enable an UNSIGNED upload preset that
# allows the paper-stish/user-assets folder, then fill these in. When unset,
# Smart Edit stores uploads in the browser (IndexedDB) instead.
NEXT_PUBLIC_SMART_EDIT_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_SMART_EDIT_CLOUDINARY_UPLOAD_PRESET=

# ─── Smart Edit — optional remote library manifest ─────────────────────────
# Defaults to the bundled /smart-edit/library/manifest.json. Point this at a
# Cloudinary-hosted JSON using the same schema to serve the asset library
# from a CDN.
NEXT_PUBLIC_SMART_EDIT_LIBRARY_URL=
