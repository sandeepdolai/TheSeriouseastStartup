// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  publications Publication[]
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* ── Publications ──────────────────────────────────────────────────────────
   Paper Stish is DEVICE-FIRST: unpublished editable projects live on the
   user's device (IndexedDB) and are never synced to the server while
   editing. The database is the source of truth only for PUBLISHED
   websites.

   Publication — the immutable-per-publish snapshot created when a user
   presses Publish. Looked up by the public viewer through the unique
   `templateId` (the last path segment of /{username}/{viewerName}/
   {templateId}), so links never carry the document payload. `data` holds
   the JSON snapshot for the template type named by `templateSlug`:
   { document } for "smart-edit", { values: {...} } for normal templates.
   Republishing updates the snapshot and keeps the same templateId.
─────────────────────────────────────────────────────────────────────────── */

model Publication {
  id           String   @id @default(cuid())
  templateId   String   @unique
  templateSlug String
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  username     String
  viewerName   String
  title        String   @default("Paper Stish")
  data         String
  publishedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId])
}


/* ── Community templates (admin-published Smart Edit starting points) ──────
   Published from Smart Edit through the "Publish Template" dialog: the
   admin fills in metadata and picks a preview (exact render or custom
   upload) before the template goes live. `document`/`assets` remain the
   editable source of truth; `previewUrl` is only the presentation image
   shown in TemplateBrowser (NULL for legacy templates → the UI renders
   the document live, as before). */
model CommunityTemplate {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String?
  document        String
  assets          String
  previewUrl      String?
  previewPublicId String?
  published       Boolean  @default(true)
  publishedBy     String
  publishedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, publishedAt])
}
